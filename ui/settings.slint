import {
    Button,
    CheckBox,
    ComboBox,
    HorizontalBox,
    LineEdit,
    Palette,
    ScrollView,
    Slider,
    SpinBox,
    VerticalBox,
} from "std-widgets.slint";

export global I18n {
    in-out property <string> window_title: "GloWled — Ambilight Controller";
    in-out property <string> tab_connection: "1. Verbindung";
    in-out property <string> tab_monitors: "2. Monitore & LEDs";
    in-out property <string> tab_image: "3. Bild & Farbe";
    in-out property <string> tab_system: "4. System";

    // Tab 0: Connection
    in-out property <string> section_wled: "WLED-Controller";
    in-out property <string> label_wled_ip: "WLED IP-Adresse:";
    in-out property <string> placeholder_wled_ip: "z. B. 192.168.1.50";
    in-out property <string> label_udp_port: "UDP Port:";
    in-out property <string> label_protocol: "UDP-Protokoll:";
    in-out property <[string]> protocol_options: ["DRGB (Standard)", "DDP", "WARLS"];
    in-out property <string> btn_test_connection: "Verbindung testen";

    // Tab 1: Monitors & LEDs
    in-out property <string> section_detected_monitors: "Erkannte Monitore";
    in-out property <string> btn_detect: "Erkennen";
    in-out property <string> badge_added: "✓ Eingebunden";
    in-out property <string> btn_add: "+ Einbinden";
    in-out property <string> btn_remove: "Entfernen";
    in-out property <string> label_top: "Oben:";
    in-out property <string> label_bottom: "Unten:";
    in-out property <string> label_left: "Links:";
    in-out property <string> label_right: "Rechts:";
    in-out property <string> label_start_corner: "Start-Ecke:";
    in-out property <[string]> corner_options: ["Unten Links", "Oben Links", "Oben Rechts", "Unten Rechts"];
    in-out property <string> label_direction: "Ausrichtung:";
    in-out property <string> dir_cw: "Uhrzeigersinn (CW)";
    in-out property <string> dir_ccw: "Gegenuhrzeigersinn (CCW)";
    in-out property <string> summary_monitors_prefix: "Monitore: ";
    in-out property <string> summary_total_leds_mid: " • Gesamt: ";
    in-out property <string> leds_unit: "LEDs";

    // Tab 2: Image & Color
    in-out property <string> section_sampling_fps: "Abtastung & Bildrate";
    in-out property <string> label_resolution: "Auflösung:";
    in-out property <[string]> resolution_options: [
        "Auto (Adaptiv)",
        "Performance (64x36)",
        "Balance (128x72)",
        "Quality (256x144)",
        "Ultra (512x288)"
    ];
    in-out property <string> label_fps_limit: "FPS-Limit: ";
    in-out property <string> section_color_gamma: "Farbe, Gamma & Kinobalken";
    in-out property <string> label_brightness: "Helligkeit: ";
    in-out property <string> label_saturation: "Sättigung: ";
    in-out property <string> label_gamma: "Gamma: ";
    in-out property <string> label_smoothing: "Glättung: ";
    in-out property <string> label_black_threshold: "Schwarz-Schwelle: ";
    in-out property <string> check_black_bar: "Kinobalken automatisch erkennen";
    in-out property <string> section_edge_strips: "Abtast-Streifen";
    in-out property <string> edge_strips_hint: "Breite & Randabstand pro Seite";
    in-out property <string> edge_depth_label: "Breite: ";
    in-out property <string> edge_offset_label: "Abstand: ";
    in-out property <string> side_top: "Oben";
    in-out property <string> side_bottom: "Unten";
    in-out property <string> side_left: "Links";
    in-out property <string> side_right: "Rechts";

    // Tab 3: System
    in-out property <string> section_operation: "Betrieb & System-Tray";
    in-out property <string> label_language: "Sprache:";
    in-out property <string> check_ambilight_active: "Ambilight aktiv";
    in-out property <string> check_eco_mode: "Eco-Modus (Standbild-Pause)";
    in-out property <string> check_autostart: "Mit Windows starten";
    in-out property <string> check_start_minimized: "Minimiert im Tray starten";
    in-out property <string> check_updates_startup: "Beim Start nach Updates suchen";
    in-out property <string> section_updates: "Updates";
    in-out property <string> label_installed_version: "Installierte Version: v";
    in-out property <string> btn_check_updates: "Nach Updates suchen";
    in-out property <string> btn_checking: "Prüfe...";

    // Bottom Bar
    in-out property <string> btn_hide_to_tray: "In Tray ausblenden";
    in-out property <string> btn_apply_save: "Übernehmen & Speichern";

    // Update Dialog
    in-out property <string> update_dialog_title: "GloWled — Update verfügbar";
    in-out property <string> update_heading: "Neue Version verfügbar";
    in-out property <string> update_section_version: "Version";
    in-out property <string> update_current_prefix: "Aktuell: v";
    in-out property <string> update_new_prefix: "   →   Neu: v";
    in-out property <string> update_package_prefix: "Paket: ";
    in-out property <string> update_section_notes: "Release-Notes";
    in-out property <string> update_confirm_prompt: "Update jetzt herunterladen und installieren?";
    in-out property <string> btn_later: "Später";
    in-out property <string> btn_update_now: "Jetzt aktualisieren";
    in-out property <string> btn_installing: "Installiere...";
}

export struct PreviewMonitorItem {
    label: string,
    colors: [color],
}

export struct DetectedMonitorItem {
    mss_index: int,
    label: string,
    resolution: string,
    is_added: bool,
}

export struct ConfiguredMonitorItem {
    mss_index: int,
    title: string,
    leds_top: int,
    leds_bottom: int,
    leds_left: int,
    leds_right: int,
    start_corner_index: int,
    clockwise: bool,
}

component SectionCard inherits Rectangle {
    in property <string> title;
    background: #18181b;
    border-color: #27272a;
    border-width: 1px;
    border-radius: 10px;

    VerticalBox {
        padding: 14px;
        spacing: 10px;

        Text {
            text: root.title;
            color: #f4f4f5;
            font-size: 14px;
            font-weight: 700;
        }

        @children
    }
}

component TabChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: root.active ? #2563eb : (touch.has-hover ? #27272a : #18181b);
    border-width: 1px;
    border-color: root.active ? #3b82f6 : #27272a;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: root.active ? #ffffff : #a1a1aa;
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component EdgeStripControl inherits Rectangle {
    in property <string> side_label;
    in property <color> accent_color;
    in-out property <int> depth_pct: 8;
    in-out property <int> offset_pct: 0;

    background: #27272a;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3f3f46;

    VerticalBox {
        padding: 10px;
        spacing: 6px;

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.accent_color;
                y: 4px;
            }
            Text {
                text: root.side_label;
                color: #f4f4f5;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Text {
                text: I18n.edge_depth_label + root.depth_pct + "%";
                color: #d4d4d8;
                font-size: 11px;
                width: 96px;
                vertical-alignment: center;
            }
            Slider {
                minimum: 1;
                maximum: 50;
                value: root.depth_pct;
                horizontal-stretch: 1;
                changed(v) => { root.depth_pct = Math.round(v); }
            }
        }

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Text {
                text: I18n.edge_offset_label + root.offset_pct + "%";
                color: #d4d4d8;
                font-size: 11px;
                width: 96px;
                vertical-alignment: center;
            }
            Slider {
                minimum: 0;
                maximum: 50;
                value: root.offset_pct;
                horizontal-stretch: 1;
                changed(v) => { root.offset_pct = Math.round(v); }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: I18n.window_title;
    preferred-width: 700px;
    preferred-height: 700px;
    min-width: 600px;
    min-height: 560px;
    background: #0f0f11;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Active tab index (0: Connection, 1: Monitors & LEDs, 2: Image & Color, 3: System)
    in-out property <int> active_tab: 0;
    in-out property <int> language_index: 0;

    // 1. Connection
    in-out property <string> wled_ip: "127.0.0.1";
    in-out property <string> wled_port: "21324";
    in-out property <int> protocol_index: 0;
    in-out property <string> connection_status: "";
    in-out property <bool> connection_ok: true;

    // 2. Monitors & LED geometry (multi-monitor)
    in-out property <[DetectedMonitorItem]> detected_monitors: [];
    in-out property <[ConfiguredMonitorItem]> configured_monitors: [];
    in-out property <int> total_leds_all_monitors: 48;

    // 3. Image & Color (global across all monitors)
    in-out property <int> fps_limit: 60;
    in-out property <float> gamma: 1.0;
    in-out property <float> brightness: 1.0;
    in-out property <float> saturation: 1.0;
    in-out property <int> smoothing_pct: 10;
    in-out property <int> black_threshold: 15;
    in-out property <bool> black_bar_detection: true;
    in-out property <int> resolution_index: 0;

    // Per-side edge strip width & distance from border (%)
    in-out property <int> edge_top_depth_pct: 8;
    in-out property <int> edge_top_offset_pct: 0;
    in-out property <int> edge_bottom_depth_pct: 8;
    in-out property <int> edge_bottom_offset_pct: 0;
    in-out property <int> edge_left_depth_pct: 8;
    in-out property <int> edge_left_offset_pct: 0;
    in-out property <int> edge_right_depth_pct: 8;
    in-out property <int> edge_right_offset_pct: 0;

    // 4. System & Live Status
    in-out property <string> app_version: "2.0.0";
    in-out property <bool> ambilight_active: true;
    in-out property <bool> eco_mode: true;
    in-out property <bool> autostart: false;
    in-out property <bool> start_minimized: true;
    in-out property <bool> check_updates_on_startup: true;
    in-out property <bool> update_checking: false;
    in-out property <string> update_status_text: "";
    in-out property <bool> update_status_error: false;
    in-out property <string> live_status_text: "";
    in-out property <string> status_badge_text: "AKTIV";
    in-out property <[PreviewMonitorItem]> preview_monitors: [];

    // Callbacks
    callback test-connection();
    callback apply-settings();
    callback toggle-active(bool);
    callback change-language(int);
    callback detect-monitors();
    callback add-monitor(int);
    callback remove-monitor(int);
    callback move-monitor(int, int);
    callback update-monitor-leds(int, int, int);
    callback update-monitor-corner(int, int);
    callback update-monitor-clockwise(int, bool);
    callback toggle-autostart(bool);
    callback check-for-updates();
    callback hide-to-tray();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // Top Header
        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            alignment: space-between;

            HorizontalBox {
                padding: 0px;
                spacing: 8px;
                Text {
                    text: "GloWled";
                    color: #38bdf8;
                    font-size: 22px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: "v" + root.app_version;
                    color: #71717a;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            HorizontalBox {
                padding: 0px;
                spacing: 8px;

                // Compact DE | EN Language Toggle Pill
                Rectangle {
                    height: 28px;
                    width: 72px;
                    border-radius: 6px;
                    background: #18181b;
                    border-width: 1px;
                    border-color: #27272a;
                    clip: true;

                    HorizontalLayout {
                        Rectangle {
                            horizontal-stretch: 1;
                            background: root.language_index == 0 ? #2563eb : (de_touch.has-hover ? #27272a : transparent);
                            de_touch := TouchArea {
                                clicked => { root.change-language(0); }
                            }
                            Text {
                                text: "DE";
                                color: root.language_index == 0 ? #ffffff : #a1a1aa;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            width: 1px;
                            background: #27272a;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: root.language_index == 1 ? #2563eb : (en_touch.has-hover ? #27272a : transparent);
                            en_touch := TouchArea {
                                clicked => { root.change-language(1); }
                            }
                            Text {
                                text: "EN";
                                color: root.language_index == 1 ? #ffffff : #a1a1aa;
                                font-size: 11px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    height: 28px;
                    min-width: 100px;
                    border-radius: 6px;
                    background: root.ambilight_active ? #064e3b : #450a0a;
                    border-width: 1px;
                    border-color: root.ambilight_active ? #10b981 : #dc2626;

                    Text {
                        text: "● " + root.status_badge_text;
                        color: root.ambilight_active ? #34d399 : #f87171;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Live Edge Color Preview Strip — visibly separated per monitor
        if root.preview_monitors.length > 0 : HorizontalLayout {
            spacing: 10px;

            for mon in root.preview_monitors : Rectangle {
                horizontal-stretch: max(1, mon.colors.length);
                height: 20px;
                border-radius: 6px;
                background: #18181b;
                border-width: 1px;
                border-color: #3f3f46;
                clip: true;

                HorizontalLayout {
                    for c in mon.colors : Rectangle {
                        background: c;
                        horizontal-stretch: 1;
                    }
                }

                if root.preview_monitors.length > 1 : Rectangle {
                    x: 4px;
                    y: 2px;
                    width: mon-badge.preferred-width + 8px;
                    height: 16px;
                    border-radius: 4px;
                    background: #09090bcc;
                    border-width: 1px;
                    border-color: #52525b;

                    mon-badge := Text {
                        text: mon.label;
                        color: #f4f4f5;
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Navigation Tabs
        HorizontalBox {
            padding: 0px;
            spacing: 8px;

            TabChip {
                label: I18n.tab_connection;
                active: root.active_tab == 0;
                horizontal-stretch: 1;
                clicked => { root.active_tab = 0; }
            }
            TabChip {
                label: I18n.tab_monitors;
                active: root.active_tab == 1;
                horizontal-stretch: 1;
                clicked => { root.active_tab = 1; }
            }
            TabChip {
                label: I18n.tab_image;
                active: root.active_tab == 2;
                horizontal-stretch: 1;
                clicked => { root.active_tab = 2; }
            }
            TabChip {
                label: I18n.tab_system;
                active: root.active_tab == 3;
                horizontal-stretch: 1;
                clicked => { root.active_tab = 3; }
            }
        }

        // Tab Body
        ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                padding: 2px;
                spacing: 12px;

                // TAB 0: Connection
                if root.active_tab == 0 : VerticalBox {
                    padding: 0px;
                    spacing: 12px;

                    SectionCard {
                        title: I18n.section_wled;

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_wled_ip;
                                color: #e4e4e7;
                                width: 140px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.wled_ip;
                                placeholder-text: I18n.placeholder_wled_ip;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_udp_port;
                                color: #e4e4e7;
                                width: 140px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.wled_port;
                                placeholder-text: "21324";
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_protocol;
                                color: #e4e4e7;
                                width: 140px;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: I18n.protocol_options;
                                current-index <=> root.protocol_index;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 12px;
                            Button {
                                text: I18n.btn_test_connection;
                                clicked => { root.test-connection(); }
                            }
                            Text {
                                text: root.connection_status;
                                color: root.connection_ok ? #34d399 : #f87171;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                // TAB 1: Monitors & LED Geometry
                if root.active_tab == 1 : VerticalBox {
                    padding: 0px;
                    spacing: 12px;

                    Rectangle {
                        background: #18181b;
                        border-color: #27272a;
                        border-width: 1px;
                        border-radius: 10px;

                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalBox {
                                padding: 0px;
                                spacing: 10px;
                                Text {
                                    text: I18n.section_detected_monitors;
                                    color: #f4f4f5;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Button {
                                    text: I18n.btn_detect;
                                    clicked => { root.detect-monitors(); }
                                }
                            }

                            for dm in root.detected_monitors : Rectangle {
                                background: #27272a;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: dm.is_added ? #065f46 : #3f3f46;

                                HorizontalBox {
                                    padding: 8px;
                                    spacing: 10px;

                                    VerticalBox {
                                        padding: 0px;
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: dm.label;
                                            color: #f4f4f5;
                                            font-size: 12px;
                                            font-weight: 700;
                                        }
                                        Text {
                                            text: dm.resolution + " • #" + dm.mss_index;
                                            color: #a1a1aa;
                                            font-size: 11px;
                                        }
                                    }

                                    if dm.is_added : Rectangle {
                                        height: 28px;
                                        min-width: 106px;
                                        border-radius: 6px;
                                        background: #064e3b;
                                        border-width: 1px;
                                        border-color: #10b981;

                                        Text {
                                            text: I18n.badge_added;
                                            color: #34d399;
                                            font-size: 11px;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if !dm.is_added : Button {
                                        text: I18n.btn_add;
                                        primary: true;
                                        clicked => { root.add-monitor(dm.mss_index); }
                                    }
                                }
                            }
                        }
                    }

                    for mon[idx] in root.configured_monitors : Rectangle {
                        background: #18181b;
                        border-color: #27272a;
                        border-width: 1px;
                        border-radius: 10px;

                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalBox {
                                padding: 0px;
                                spacing: 8px;

                                Text {
                                    text: "#" + (idx + 1) + " • " + mon.title;
                                    color: #f4f4f5;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    height: 24px;
                                    min-width: 72px;
                                    border-radius: 6px;
                                    background: #064e3b;
                                    border-width: 1px;
                                    border-color: #10b981;

                                    Text {
                                        text: (mon.leds_top + mon.leds_bottom + mon.leds_left + mon.leds_right) + " " + I18n.leds_unit;
                                        color: #34d399;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Button {
                                    text: "↑";
                                    enabled: idx > 0;
                                    clicked => { root.move-monitor(idx, -1); }
                                }

                                Button {
                                    text: "↓";
                                    enabled: idx + 1 < root.configured_monitors.length;
                                    clicked => { root.move-monitor(idx, 1); }
                                }

                                Button {
                                    text: I18n.btn_remove;
                                    enabled: root.configured_monitors.length > 1;
                                    clicked => { root.remove-monitor(idx); }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 12px;
                                Text { text: I18n.label_top; color: #e4e4e7; width: 66px; vertical-alignment: center; }
                                SpinBox {
                                    value: mon.leds_top;
                                    minimum: 0;
                                    maximum: 500;
                                    horizontal-stretch: 1;
                                    edited(v) => { root.update-monitor-leds(idx, 0, v); }
                                }
                                Text { text: I18n.label_bottom; color: #e4e4e7; width: 66px; vertical-alignment: center; }
                                SpinBox {
                                    value: mon.leds_bottom;
                                    minimum: 0;
                                    maximum: 500;
                                    horizontal-stretch: 1;
                                    edited(v) => { root.update-monitor-leds(idx, 1, v); }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 12px;
                                Text { text: I18n.label_left; color: #e4e4e7; width: 66px; vertical-alignment: center; }
                                SpinBox {
                                    value: mon.leds_left;
                                    minimum: 0;
                                    maximum: 500;
                                    horizontal-stretch: 1;
                                    edited(v) => { root.update-monitor-leds(idx, 2, v); }
                                }
                                Text { text: I18n.label_right; color: #e4e4e7; width: 66px; vertical-alignment: center; }
                                SpinBox {
                                    value: mon.leds_right;
                                    minimum: 0;
                                    maximum: 500;
                                    horizontal-stretch: 1;
                                    edited(v) => { root.update-monitor-leds(idx, 3, v); }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 10px;
                                Text {
                                    text: I18n.label_start_corner;
                                    color: #e4e4e7;
                                    width: 115px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: I18n.corner_options;
                                    current-index: mon.start_corner_index;
                                    horizontal-stretch: 1;
                                    selected(_) => { root.update-monitor-corner(idx, self.current-index); }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 10px;
                                Text {
                                    text: I18n.label_direction;
                                    color: #e4e4e7;
                                    width: 115px;
                                    vertical-alignment: center;
                                }
                                CheckBox {
                                    text: mon.clockwise ? I18n.dir_cw : I18n.dir_ccw;
                                    checked: mon.clockwise;
                                    toggled => { root.update-monitor-clockwise(idx, self.checked); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #18181b;
                        border-color: #27272a;
                        border-width: 1px;
                        border-radius: 10px;
                        height: 40px;

                        HorizontalBox {
                            padding: 10px;
                            Text {
                                text: I18n.summary_monitors_prefix + root.configured_monitors.length + I18n.summary_total_leds_mid + root.total_leds_all_monitors + " " + I18n.leds_unit;
                                color: #10b981;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // TAB 2: Image & Color
                if root.active_tab == 2 : VerticalBox {
                    padding: 0px;
                    spacing: 12px;

                    SectionCard {
                        title: I18n.section_sampling_fps;

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text { text: I18n.label_resolution; color: #e4e4e7; width: 155px; vertical-alignment: center; }
                            ComboBox {
                                model: I18n.resolution_options;
                                current-index <=> root.resolution_index;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_fps_limit + root.fps_limit;
                                color: #e4e4e7;
                                width: 155px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 15;
                                maximum: 120;
                                value: root.fps_limit;
                                horizontal-stretch: 1;
                                changed(v) => { root.fps_limit = Math.round(v); }
                            }
                        }
                    }

                    SectionCard {
                        title: I18n.section_color_gamma;

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_brightness + (Math.round(root.brightness * 10) / 10) + "x";
                                color: #e4e4e7;
                                width: 155px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 0.1;
                                maximum: 3.0;
                                value <=> root.brightness;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_saturation + (Math.round(root.saturation * 10) / 10) + "x";
                                color: #e4e4e7;
                                width: 155px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 0.0;
                                maximum: 3.0;
                                value <=> root.saturation;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_gamma + (Math.round(root.gamma * 10) / 10);
                                color: #e4e4e7;
                                width: 155px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 1.0;
                                maximum: 3.0;
                                value <=> root.gamma;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_smoothing + root.smoothing_pct + "%";
                                color: #e4e4e7;
                                width: 155px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 0;
                                maximum: 90;
                                value: root.smoothing_pct;
                                horizontal-stretch: 1;
                                changed(v) => { root.smoothing_pct = Math.round(v); }
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_black_threshold + root.black_threshold;
                                color: #e4e4e7;
                                width: 155px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 0;
                                maximum: 50;
                                value: root.black_threshold;
                                horizontal-stretch: 1;
                                changed(v) => { root.black_threshold = Math.round(v); }
                            }
                        }

                        CheckBox {
                            text: I18n.check_black_bar;
                            checked <=> root.black_bar_detection;
                        }
                    }

                    SectionCard {
                        title: I18n.section_edge_strips;

                        HorizontalBox {
                            padding: 0px;
                            spacing: 14px;

                            Text {
                                text: I18n.edge_strips_hint;
                                color: #a1a1aa;
                                font-size: 12px;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            // Live visual diagram of the 4 sampling strips
                            Rectangle {
                                width: 144px;
                                height: 81px;
                                background: #09090b;
                                border-width: 1px;
                                border-color: #52525b;
                                border-radius: 4px;
                                clip: true;

                                // Top strip
                                Rectangle {
                                    x: 0px;
                                    y: (root.edge_top_offset_pct / 100) * parent.height;
                                    width: parent.width;
                                    height: max(2px, min(parent.height - self.y, (root.edge_top_depth_pct / 100) * parent.height));
                                    background: #38bdf866;
                                    border-width: 1px;
                                    border-color: #38bdf8;
                                }

                                // Bottom strip
                                Rectangle {
                                    property <length> off_b: (root.edge_bottom_offset_pct / 100) * parent.height;
                                    property <length> h_b: max(2px, min(parent.height - off_b, (root.edge_bottom_depth_pct / 100) * parent.height));
                                    x: 0px;
                                    y: parent.height - off_b - h_b;
                                    width: parent.width;
                                    height: h_b;
                                    background: #34d39966;
                                    border-width: 1px;
                                    border-color: #34d399;
                                }

                                // Left strip
                                Rectangle {
                                    x: (root.edge_left_offset_pct / 100) * parent.width;
                                    y: 0px;
                                    width: max(2px, min(parent.width - self.x, (root.edge_left_depth_pct / 100) * parent.width));
                                    height: parent.height;
                                    background: #f59e0b66;
                                    border-width: 1px;
                                    border-color: #f59e0b;
                                }

                                // Right strip
                                Rectangle {
                                    property <length> off_r: (root.edge_right_offset_pct / 100) * parent.width;
                                    property <length> w_r: max(2px, min(parent.width - off_r, (root.edge_right_depth_pct / 100) * parent.width));
                                    x: parent.width - off_r - w_r;
                                    y: 0px;
                                    width: w_r;
                                    height: parent.height;
                                    background: #c084fc66;
                                    border-width: 1px;
                                    border-color: #c084fc;
                                }
                            }
                        }

                        EdgeStripControl {
                            side_label: I18n.side_top;
                            accent_color: #38bdf8;
                            depth_pct <=> root.edge_top_depth_pct;
                            offset_pct <=> root.edge_top_offset_pct;
                        }

                        EdgeStripControl {
                            side_label: I18n.side_bottom;
                            accent_color: #34d399;
                            depth_pct <=> root.edge_bottom_depth_pct;
                            offset_pct <=> root.edge_bottom_offset_pct;
                        }

                        EdgeStripControl {
                            side_label: I18n.side_left;
                            accent_color: #f59e0b;
                            depth_pct <=> root.edge_left_depth_pct;
                            offset_pct <=> root.edge_left_offset_pct;
                        }

                        EdgeStripControl {
                            side_label: I18n.side_right;
                            accent_color: #c084fc;
                            depth_pct <=> root.edge_right_depth_pct;
                            offset_pct <=> root.edge_right_offset_pct;
                        }
                    }
                }

                // TAB 3: System
                if root.active_tab == 3 : VerticalBox {
                    padding: 0px;
                    spacing: 12px;

                    SectionCard {
                        title: I18n.section_operation;

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_language;
                                color: #e4e4e7;
                                width: 140px;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: ["Deutsch", "English"];
                                current-index: root.language_index;
                                horizontal-stretch: 1;
                                selected(_) => { root.change-language(self.current-index); }
                            }
                        }

                        CheckBox {
                            text: I18n.check_ambilight_active;
                            checked <=> root.ambilight_active;
                            toggled => { root.toggle-active(self.checked); }
                        }

                        CheckBox {
                            text: I18n.check_eco_mode;
                            checked <=> root.eco_mode;
                        }

                        CheckBox {
                            text: I18n.check_autostart;
                            checked <=> root.autostart;
                            toggled => { root.toggle-autostart(self.checked); }
                        }

                        CheckBox {
                            text: I18n.check_start_minimized;
                            checked <=> root.start_minimized;
                        }

                        CheckBox {
                            text: I18n.check_updates_startup;
                            checked <=> root.check_updates_on_startup;
                        }
                    }

                    SectionCard {
                        title: I18n.section_updates;

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: I18n.label_installed_version + root.app_version;
                                color: #f4f4f5;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.update_checking ? I18n.btn_checking : I18n.btn_check_updates;
                                enabled: !root.update_checking;
                                clicked => { root.check-for-updates(); }
                            }
                        }

                        Text {
                            text: root.update_status_text;
                            color: root.update_status_error ? #f87171 : #a1a1aa;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // Bottom Action Bar
        Rectangle {
            height: 1px;
            background: #27272a;
        }

        HorizontalBox {
            padding: 0px;
            spacing: 10px;

            Text {
                text: root.live_status_text;
                color: #a1a1aa;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Button {
                text: I18n.btn_hide_to_tray;
                clicked => { root.hide-to-tray(); }
            }

            Button {
                text: I18n.btn_apply_save;
                primary: true;
                clicked => { root.apply-settings(); }
            }
        }
    }
}

export component UpdateDialog inherits Window {
    title: I18n.update_dialog_title;
    preferred-width: 540px;
    preferred-height: 440px;
    min-width: 460px;
    min-height: 360px;
    background: #0f0f11;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    in-out property <string> current_version: "2.0.0";
    in-out property <string> new_version: "";
    in-out property <string> asset_name: "";
    in-out property <string> release_notes: "";
    in-out property <string> status_message: "";
    in-out property <bool> is_error: false;
    in-out property <bool> is_busy: false;

    callback install-update();
    callback dismiss-update();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            Text {
                text: I18n.update_heading;
                color: #38bdf8;
                font-size: 18px;
                font-weight: 800;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Rectangle {
                height: 26px;
                min-width: 84px;
                border-radius: 6px;
                background: #064e3b;
                border-width: 1px;
                border-color: #10b981;
                Text {
                    text: "v" + root.new_version;
                    color: #34d399;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        SectionCard {
            title: I18n.update_section_version;
            Text {
                text: I18n.update_current_prefix + root.current_version + I18n.update_new_prefix + root.new_version;
                color: #f4f4f5;
                font-size: 13px;
                font-weight: 700;
            }
            if root.asset_name != "" : Text {
                text: I18n.update_package_prefix + root.asset_name;
                color: #a1a1aa;
                font-size: 11px;
            }
        }

        SectionCard {
            title: I18n.update_section_notes;
            vertical-stretch: 1;

            ScrollView {
                vertical-stretch: 1;
                Text {
                    text: root.release_notes;
                    color: #d4d4d8;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        if root.status_message != "" : Text {
            text: root.status_message;
            color: root.is_error ? #f87171 : #38bdf8;
            font-size: 12px;
            wrap: word-wrap;
        }

        Text {
            text: I18n.update_confirm_prompt;
            color: #e4e4e7;
            font-size: 12px;
            font-weight: 600;
        }

        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            alignment: end;

            Button {
                text: I18n.btn_later;
                enabled: !root.is_busy;
                clicked => { root.dismiss-update(); }
            }

            Button {
                text: root.is_busy ? I18n.btn_installing : I18n.btn_update_now;
                primary: true;
                enabled: !root.is_busy;
                clicked => { root.install-update(); }
            }
        }
    }
}
