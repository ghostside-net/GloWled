import {
    Button,
    CheckBox,
    ComboBox,
    HorizontalBox,
    LineEdit,
    Palette,
    ScrollView,
    Slider,
    SpinBox,
    VerticalBox,
} from "std-widgets.slint";

export struct PreviewMonitorItem {
    label: string,
    colors: [color],
}

export struct DetectedMonitorItem {
    mss_index: int,
    label: string,
    resolution: string,
    is_added: bool,
}

export struct ConfiguredMonitorItem {
    mss_index: int,
    title: string,
    leds_top: int,
    leds_bottom: int,
    leds_left: int,
    leds_right: int,
    start_corner_index: int,
    clockwise: bool,
}

component SectionCard inherits Rectangle {
    in property <string> title;
    background: #18181b;
    border-color: #27272a;
    border-width: 1px;
    border-radius: 10px;

    VerticalBox {
        padding: 14px;
        spacing: 10px;

        Text {
            text: root.title;
            color: #f4f4f5;
            font-size: 14px;
            font-weight: 700;
        }

        @children
    }
}

component TabChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();

    height: 34px;
    border-radius: 8px;
    background: root.active ? #2563eb : (touch.has-hover ? #27272a : #18181b);
    border-width: 1px;
    border-color: root.active ? #3b82f6 : #27272a;

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.label;
        color: root.active ? #ffffff : #a1a1aa;
        font-size: 12px;
        font-weight: root.active ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component EdgeStripControl inherits Rectangle {
    in property <string> side_label;
    in property <color> accent_color;
    in-out property <int> depth_pct: 8;
    in-out property <int> offset_pct: 0;

    background: #27272a;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3f3f46;

    VerticalBox {
        padding: 10px;
        spacing: 6px;

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.accent_color;
                y: 4px;
            }
            Text {
                text: root.side_label;
                color: #f4f4f5;
                font-size: 12px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Text {
                text: "Streifenbreite: " + root.depth_pct + "%";
                color: #d4d4d8;
                font-size: 11px;
                width: 128px;
                vertical-alignment: center;
            }
            Slider {
                minimum: 1;
                maximum: 50;
                value: root.depth_pct;
                horizontal-stretch: 1;
                changed(v) => { root.depth_pct = Math.round(v); }
            }
        }

        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            Text {
                text: "Randabstand: " + root.offset_pct + "%";
                color: #d4d4d8;
                font-size: 11px;
                width: 128px;
                vertical-alignment: center;
            }
            Slider {
                minimum: 0;
                maximum: 50;
                value: root.offset_pct;
                horizontal-stretch: 1;
                changed(v) => { root.offset_pct = Math.round(v); }
            }
        }
    }
}

export component SettingsWindow inherits Window {
    title: "GloWled — Ambilight Controller";
    preferred-width: 700px;
    preferred-height: 780px;
    min-width: 600px;
    min-height: 640px;
    background: #0f0f11;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Active tab index (0: Verbindung, 1: Monitore & LEDs, 2: Bild & Farbe, 3: System)
    in-out property <int> active_tab: 0;

    // 1. Verbindung
    in-out property <string> wled_ip: "127.0.0.1";
    in-out property <string> wled_port: "21324";
    in-out property <int> protocol_index: 0;
    in-out property <string> connection_status: "";
    in-out property <bool> connection_ok: true;

    // 2. Monitore & LED-Geometrie (multi-monitor)
    in-out property <[DetectedMonitorItem]> detected_monitors: [];
    in-out property <[ConfiguredMonitorItem]> configured_monitors: [];
    in-out property <int> total_leds_all_monitors: 48;

    // 3. Bild & Farbe (global across all monitors)
    in-out property <int> fps_limit: 60;
    in-out property <float> gamma: 1.0;
    in-out property <float> brightness: 1.0;
    in-out property <float> saturation: 1.0;
    in-out property <int> smoothing_pct: 10;
    in-out property <int> black_threshold: 15;
    in-out property <bool> black_bar_detection: true;
    in-out property <int> resolution_index: 0;

    // Per-side edge strip width & distance from border (%)
    in-out property <int> edge_top_depth_pct: 8;
    in-out property <int> edge_top_offset_pct: 0;
    in-out property <int> edge_bottom_depth_pct: 8;
    in-out property <int> edge_bottom_offset_pct: 0;
    in-out property <int> edge_left_depth_pct: 8;
    in-out property <int> edge_left_offset_pct: 0;
    in-out property <int> edge_right_depth_pct: 8;
    in-out property <int> edge_right_offset_pct: 0;

    // 4. System & Live Status
    in-out property <string> app_version: "2.0.0";
    in-out property <bool> ambilight_active: true;
    in-out property <bool> eco_mode: true;
    in-out property <bool> autostart: false;
    in-out property <bool> start_minimized: true;
    in-out property <bool> check_updates_on_startup: true;
    in-out property <bool> update_checking: false;
    in-out property <string> update_status_text: "Noch nicht geprüft";
    in-out property <bool> update_status_error: false;
    in-out property <string> live_status_text: "Bereit";
    in-out property <string> status_badge_text: "AKTIV";
    in-out property <[PreviewMonitorItem]> preview_monitors: [];

    // Callbacks
    callback test-connection();
    callback apply-settings();
    callback toggle-active(bool);
    callback detect-monitors();
    callback add-monitor(int);
    callback remove-monitor(int);
    callback move-monitor(int, int);
    callback update-monitor-leds(int, int, int);
    callback update-monitor-corner(int, int);
    callback update-monitor-clockwise(int, bool);
    callback toggle-autostart(bool);
    callback check-for-updates();
    callback hide-to-tray();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        // Top Header
        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            alignment: space-between;

            HorizontalBox {
                padding: 0px;
                spacing: 6px;
                Text {
                    text: "GloWled";
                    color: #38bdf8;
                    font-size: 22px;
                    font-weight: 800;
                    vertical-alignment: center;
                }
                Text {
                    text: "• Rust + Slint Edition";
                    color: #71717a;
                    font-size: 13px;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 28px;
                min-width: 110px;
                border-radius: 6px;
                background: root.ambilight_active ? #064e3b : #450a0a;
                border-width: 1px;
                border-color: root.ambilight_active ? #10b981 : #dc2626;

                Text {
                    text: "● " + root.status_badge_text;
                    color: root.ambilight_active ? #34d399 : #f87171;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Live Edge Color Preview Strip — visibly separated per monitor
        if root.preview_monitors.length > 0 : HorizontalLayout {
            spacing: 10px;

            for mon in root.preview_monitors : Rectangle {
                horizontal-stretch: max(1, mon.colors.length);
                height: 20px;
                border-radius: 6px;
                background: #18181b;
                border-width: 1px;
                border-color: #3f3f46;
                clip: true;

                HorizontalLayout {
                    for c in mon.colors : Rectangle {
                        background: c;
                        horizontal-stretch: 1;
                    }
                }

                if root.preview_monitors.length > 1 : Rectangle {
                    x: 4px;
                    y: 2px;
                    width: mon-badge.preferred-width + 8px;
                    height: 16px;
                    border-radius: 4px;
                    background: #09090bcc;
                    border-width: 1px;
                    border-color: #52525b;

                    mon-badge := Text {
                        text: mon.label;
                        color: #f4f4f5;
                        font-size: 9px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Navigation Tabs
        HorizontalBox {
            padding: 0px;
            spacing: 8px;

            TabChip {
                label: "1. Verbindung";
                active: root.active_tab == 0;
                horizontal-stretch: 1;
                clicked => { root.active_tab = 0; }
            }
            TabChip {
                label: "2. Monitore & LEDs";
                active: root.active_tab == 1;
                horizontal-stretch: 1;
                clicked => { root.active_tab = 1; }
            }
            TabChip {
                label: "3. Bild & Farbe";
                active: root.active_tab == 2;
                horizontal-stretch: 1;
                clicked => { root.active_tab = 2; }
            }
            TabChip {
                label: "4. System";
                active: root.active_tab == 3;
                horizontal-stretch: 1;
                clicked => { root.active_tab = 3; }
            }
        }

        // Tab Body
        ScrollView {
            vertical-stretch: 1;

            VerticalBox {
                padding: 2px;
                spacing: 12px;

                // TAB 0: Verbindung
                if root.active_tab == 0 : VerticalBox {
                    padding: 0px;
                    spacing: 12px;

                    SectionCard {
                        title: "WLED-Controller Verbindung";

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "WLED IP-Adresse:";
                                color: #e4e4e7;
                                width: 140px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.wled_ip;
                                placeholder-text: "z. B. 192.168.1.50";
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "UDP Port:";
                                color: #e4e4e7;
                                width: 140px;
                                vertical-alignment: center;
                            }
                            LineEdit {
                                text <=> root.wled_port;
                                placeholder-text: "21324";
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "UDP-Protokoll:";
                                color: #e4e4e7;
                                width: 140px;
                                vertical-alignment: center;
                            }
                            ComboBox {
                                model: ["DRGB (WLED Standard)", "DDP (Distributed Display)", "WARLS (Legacy)"];
                                current-index <=> root.protocol_index;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 12px;
                            Button {
                                text: "Verbindung testen (UDP Probe)";
                                clicked => { root.test-connection(); }
                            }
                            Text {
                                text: root.connection_status;
                                color: root.connection_ok ? #34d399 : #f87171;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                        }
                    }

                    SectionCard {
                        title: "Hinweise zu WLED";
                        Text {
                            text: "• Stellen Sie in WLED unter Config → Sync Interfaces sicher, dass 'Receive Realtime' auf Port 21324 (DRGB) bzw. Port 4048 (DDP) aktiv ist.\n• Änderungen greifen nach Klick auf 'Übernehmen & Speichern' ohne Neustart verzögerungsfrei.";
                            color: #a1a1aa;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                // TAB 1: Monitore & LED-Geometrie
                if root.active_tab == 1 : VerticalBox {
                    padding: 0px;
                    spacing: 12px;

                    SectionCard {
                        title: "Erkannte System-Monitore";

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "Binden Sie beliebig viele erkannte Monitore in Ihre LED-Kette ein:";
                                color: #a1a1aa;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                wrap: word-wrap;
                            }
                            Button {
                                text: "Erkennen";
                                clicked => { root.detect-monitors(); }
                            }
                        }

                        for dm in root.detected_monitors : Rectangle {
                            background: #27272a;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: dm.is_added ? #065f46 : #3f3f46;

                            HorizontalBox {
                                padding: 8px;
                                spacing: 10px;

                                VerticalBox {
                                    padding: 0px;
                                    spacing: 2px;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: dm.label;
                                        color: #f4f4f5;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    Text {
                                        text: "Auflösung: " + dm.resolution + " • Index " + dm.mss_index;
                                        color: #a1a1aa;
                                        font-size: 11px;
                                    }
                                }

                                if dm.is_added : Rectangle {
                                    height: 28px;
                                    min-width: 106px;
                                    border-radius: 6px;
                                    background: #064e3b;
                                    border-width: 1px;
                                    border-color: #10b981;

                                    Text {
                                        text: "✓ Eingebunden";
                                        color: #34d399;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                if !dm.is_added : Button {
                                    text: "+ Einbinden";
                                    primary: true;
                                    clicked => { root.add-monitor(dm.mss_index); }
                                }
                            }
                        }
                    }

                    for mon[idx] in root.configured_monitors : Rectangle {
                        background: #18181b;
                        border-color: #27272a;
                        border-width: 1px;
                        border-radius: 10px;

                        VerticalBox {
                            padding: 14px;
                            spacing: 10px;

                            HorizontalBox {
                                padding: 0px;
                                spacing: 8px;

                                Text {
                                    text: "#" + (idx + 1) + " • " + mon.title;
                                    color: #f4f4f5;
                                    font-size: 14px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }

                                Rectangle {
                                    height: 24px;
                                    min-width: 72px;
                                    border-radius: 6px;
                                    background: #064e3b;
                                    border-width: 1px;
                                    border-color: #10b981;

                                    Text {
                                        text: (mon.leds_top + mon.leds_bottom + mon.leds_left + mon.leds_right) + " LEDs";
                                        color: #34d399;
                                        font-size: 11px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Button {
                                    text: "↑";
                                    enabled: idx > 0;
                                    clicked => { root.move-monitor(idx, -1); }
                                }

                                Button {
                                    text: "↓";
                                    enabled: idx + 1 < root.configured_monitors.length;
                                    clicked => { root.move-monitor(idx, 1); }
                                }

                                Button {
                                    text: "Entfernen";
                                    enabled: root.configured_monitors.length > 1;
                                    clicked => { root.remove-monitor(idx); }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 12px;
                                Text { text: "Oben:"; color: #e4e4e7; width: 62px; vertical-alignment: center; }
                                SpinBox {
                                    value: mon.leds_top;
                                    minimum: 0;
                                    maximum: 500;
                                    horizontal-stretch: 1;
                                    edited(v) => { root.update-monitor-leds(idx, 0, v); }
                                }
                                Text { text: "Unten:"; color: #e4e4e7; width: 62px; vertical-alignment: center; }
                                SpinBox {
                                    value: mon.leds_bottom;
                                    minimum: 0;
                                    maximum: 500;
                                    horizontal-stretch: 1;
                                    edited(v) => { root.update-monitor-leds(idx, 1, v); }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 12px;
                                Text { text: "Links:"; color: #e4e4e7; width: 62px; vertical-alignment: center; }
                                SpinBox {
                                    value: mon.leds_left;
                                    minimum: 0;
                                    maximum: 500;
                                    horizontal-stretch: 1;
                                    edited(v) => { root.update-monitor-leds(idx, 2, v); }
                                }
                                Text { text: "Rechts:"; color: #e4e4e7; width: 62px; vertical-alignment: center; }
                                SpinBox {
                                    value: mon.leds_right;
                                    minimum: 0;
                                    maximum: 500;
                                    horizontal-stretch: 1;
                                    edited(v) => { root.update-monitor-leds(idx, 3, v); }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 10px;
                                Text {
                                    text: "Start-Ecke:";
                                    color: #e4e4e7;
                                    width: 110px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["Unten Links", "Oben Links", "Oben Rechts", "Unten Rechts"];
                                    current-index: mon.start_corner_index;
                                    horizontal-stretch: 1;
                                    selected(_) => { root.update-monitor-corner(idx, self.current-index); }
                                }
                            }

                            HorizontalBox {
                                padding: 0px;
                                spacing: 10px;
                                Text {
                                    text: "Ausrichtung:";
                                    color: #e4e4e7;
                                    width: 110px;
                                    vertical-alignment: center;
                                }
                                CheckBox {
                                    text: mon.clockwise ? "Uhrzeigersinn (CW)" : "Gegenuhrzeigersinn (CCW)";
                                    checked: mon.clockwise;
                                    toggled => { root.update-monitor-clockwise(idx, self.checked); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #18181b;
                        border-color: #27272a;
                        border-width: 1px;
                        border-radius: 10px;
                        height: 40px;

                        HorizontalBox {
                            padding: 10px;
                            Text {
                                text: "Eingebundene Monitore: " + root.configured_monitors.length + " • Gesamtanzahl LEDs in der Kette: " + root.total_leds_all_monitors;
                                color: #10b981;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // TAB 2: Bild & Farbe (generalized across all monitors)
                if root.active_tab == 2 : VerticalBox {
                    padding: 0px;
                    spacing: 12px;

                    SectionCard {
                        title: "Abtastung & Bildrate (gilt für alle Monitore)";

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text { text: "Abtast-Auflösung:"; color: #e4e4e7; width: 130px; vertical-alignment: center; }
                            ComboBox {
                                model: [
                                    "Auto (Adaptiv)",
                                    "Performance (64x36)",
                                    "Balance (128x72)",
                                    "Quality (256x144)",
                                    "Ultra (512x288)"
                                ];
                                current-index <=> root.resolution_index;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "FPS-Limit: " + root.fps_limit;
                                color: #e4e4e7;
                                width: 130px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 15;
                                maximum: 120;
                                value: root.fps_limit;
                                horizontal-stretch: 1;
                                changed(v) => { root.fps_limit = Math.round(v); }
                            }
                        }
                    }

                    SectionCard {
                        title: "Farbe, Gamma & Kinobalken";

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "Helligkeit: " + (Math.round(root.brightness * 10) / 10) + "x";
                                color: #e4e4e7;
                                width: 150px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 0.1;
                                maximum: 3.0;
                                value <=> root.brightness;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "Sättigung: " + (Math.round(root.saturation * 10) / 10) + "x";
                                color: #e4e4e7;
                                width: 150px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 0.0;
                                maximum: 3.0;
                                value <=> root.saturation;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "Gamma: " + (Math.round(root.gamma * 10) / 10);
                                color: #e4e4e7;
                                width: 150px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 1.0;
                                maximum: 3.0;
                                value <=> root.gamma;
                                horizontal-stretch: 1;
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "Glättung: " + root.smoothing_pct + "%";
                                color: #e4e4e7;
                                width: 150px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 0;
                                maximum: 90;
                                value: root.smoothing_pct;
                                horizontal-stretch: 1;
                                changed(v) => { root.smoothing_pct = Math.round(v); }
                            }
                        }

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "Schwarz-Schwelle: " + root.black_threshold;
                                color: #e4e4e7;
                                width: 150px;
                                vertical-alignment: center;
                            }
                            Slider {
                                minimum: 0;
                                maximum: 50;
                                value: root.black_threshold;
                                horizontal-stretch: 1;
                                changed(v) => { root.black_threshold = Math.round(v); }
                            }
                        }

                        CheckBox {
                            text: "Black-Bar-Detection (schwarze Kinobalken automatisch überspringen)";
                            checked <=> root.black_bar_detection;
                        }
                    }

                    SectionCard {
                        title: "Abtast-Streifen pro Bildschirmseite";

                        HorizontalBox {
                            padding: 0px;
                            spacing: 14px;

                            Text {
                                text: "Stellen Sie für jede Seite separat ein, wie breit der auszuwertende Farbstreifen ist und wie weit entfernt vom Bildschirmrand er beginnt (z. B. um Taskleisten oder HUDs auszublenden).";
                                color: #a1a1aa;
                                font-size: 12px;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            // Live visual diagram of the 4 sampling strips
                            Rectangle {
                                width: 144px;
                                height: 81px;
                                background: #09090b;
                                border-width: 1px;
                                border-color: #52525b;
                                border-radius: 4px;
                                clip: true;

                                // Top strip
                                Rectangle {
                                    x: 0px;
                                    y: (root.edge_top_offset_pct / 100) * parent.height;
                                    width: parent.width;
                                    height: max(2px, min(parent.height - self.y, (root.edge_top_depth_pct / 100) * parent.height));
                                    background: #38bdf866;
                                    border-width: 1px;
                                    border-color: #38bdf8;
                                }

                                // Bottom strip
                                Rectangle {
                                    property <length> off_b: (root.edge_bottom_offset_pct / 100) * parent.height;
                                    property <length> h_b: max(2px, min(parent.height - off_b, (root.edge_bottom_depth_pct / 100) * parent.height));
                                    x: 0px;
                                    y: parent.height - off_b - h_b;
                                    width: parent.width;
                                    height: h_b;
                                    background: #34d39966;
                                    border-width: 1px;
                                    border-color: #34d399;
                                }

                                // Left strip
                                Rectangle {
                                    x: (root.edge_left_offset_pct / 100) * parent.width;
                                    y: 0px;
                                    width: max(2px, min(parent.width - self.x, (root.edge_left_depth_pct / 100) * parent.width));
                                    height: parent.height;
                                    background: #f59e0b66;
                                    border-width: 1px;
                                    border-color: #f59e0b;
                                }

                                // Right strip
                                Rectangle {
                                    property <length> off_r: (root.edge_right_offset_pct / 100) * parent.width;
                                    property <length> w_r: max(2px, min(parent.width - off_r, (root.edge_right_depth_pct / 100) * parent.width));
                                    x: parent.width - off_r - w_r;
                                    y: 0px;
                                    width: w_r;
                                    height: parent.height;
                                    background: #c084fc66;
                                    border-width: 1px;
                                    border-color: #c084fc;
                                }
                            }
                        }

                        EdgeStripControl {
                            side_label: "Oben";
                            accent_color: #38bdf8;
                            depth_pct <=> root.edge_top_depth_pct;
                            offset_pct <=> root.edge_top_offset_pct;
                        }

                        EdgeStripControl {
                            side_label: "Unten";
                            accent_color: #34d399;
                            depth_pct <=> root.edge_bottom_depth_pct;
                            offset_pct <=> root.edge_bottom_offset_pct;
                        }

                        EdgeStripControl {
                            side_label: "Links";
                            accent_color: #f59e0b;
                            depth_pct <=> root.edge_left_depth_pct;
                            offset_pct <=> root.edge_left_offset_pct;
                        }

                        EdgeStripControl {
                            side_label: "Rechts";
                            accent_color: #c084fc;
                            depth_pct <=> root.edge_right_depth_pct;
                            offset_pct <=> root.edge_right_offset_pct;
                        }
                    }
                }

                // TAB 3: System
                if root.active_tab == 3 : VerticalBox {
                    padding: 0px;
                    spacing: 12px;

                    SectionCard {
                        title: "Betrieb & System-Tray";

                        CheckBox {
                            text: "Ambilight Capture & Streaming aktiv";
                            checked <=> root.ambilight_active;
                            toggled => { root.toggle-active(self.checked); }
                        }

                        CheckBox {
                            text: "Eco-Modus (CPU-Last bei Standbildern auf ~0% senken)";
                            checked <=> root.eco_mode;
                        }

                        CheckBox {
                            text: "Autostart beim Windows-Login (HKCU\\...\\Run)";
                            checked <=> root.autostart;
                            toggled => { root.toggle-autostart(self.checked); }
                        }

                        CheckBox {
                            text: "Immer direkt minimiert im System-Tray starten";
                            checked <=> root.start_minimized;
                        }

                        CheckBox {
                            text: "Beim Start automatisch nach Updates suchen";
                            checked <=> root.check_updates_on_startup;
                        }
                    }

                    SectionCard {
                        title: "Updates (GitHub Releases)";

                        HorizontalBox {
                            padding: 0px;
                            spacing: 10px;
                            Text {
                                text: "Installierte Version: v" + root.app_version;
                                color: #f4f4f5;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            Button {
                                text: root.update_checking ? "Prüfe..." : "Nach Updates suchen";
                                enabled: !root.update_checking;
                                clicked => { root.check-for-updates(); }
                            }
                        }

                        Text {
                            text: root.update_status_text;
                            color: root.update_status_error ? #f87171 : #a1a1aa;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    SectionCard {
                        title: "Info & Ressourcen";
                        Text {
                            text: "GloWled v" + root.app_version + " — Native Rust Single-Binary mit Slint UI.\nBeim Klick auf [X] wird nur das Fenster ausgeblendet (0% GPU/GUI-Overhead), während der Capture-Worker unauffällig im System-Tray weiterläuft.";
                            color: #a1a1aa;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // Bottom Action Bar
        Rectangle {
            height: 1px;
            background: #27272a;
        }

        HorizontalBox {
            padding: 0px;
            spacing: 10px;

            Text {
                text: root.live_status_text;
                color: #a1a1aa;
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Button {
                text: "In Tray ausblenden";
                clicked => { root.hide-to-tray(); }
            }

            Button {
                text: "Übernehmen & Speichern";
                primary: true;
                clicked => { root.apply-settings(); }
            }
        }
    }
}

export component UpdateDialog inherits Window {
    title: "GloWled — Software-Update verfügbar";
    preferred-width: 540px;
    preferred-height: 440px;
    min-width: 460px;
    min-height: 360px;
    background: #0f0f11;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    in-out property <string> current_version: "2.0.0";
    in-out property <string> new_version: "";
    in-out property <string> asset_name: "";
    in-out property <string> release_notes: "";
    in-out property <string> status_message: "";
    in-out property <bool> is_error: false;
    in-out property <bool> is_busy: false;

    callback install-update();
    callback dismiss-update();

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            Text {
                text: "Neue GloWled-Version verfügbar";
                color: #38bdf8;
                font-size: 18px;
                font-weight: 800;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Rectangle {
                height: 26px;
                min-width: 84px;
                border-radius: 6px;
                background: #064e3b;
                border-width: 1px;
                border-color: #10b981;
                Text {
                    text: "v" + root.new_version;
                    color: #34d399;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        SectionCard {
            title: "Versionsübersicht";
            Text {
                text: "Aktuelle Version: v" + root.current_version + "   →   Neue Version: v" + root.new_version;
                color: #f4f4f5;
                font-size: 13px;
                font-weight: 700;
            }
            if root.asset_name != "" : Text {
                text: "Download-Paket: " + root.asset_name;
                color: #a1a1aa;
                font-size: 11px;
            }
        }

        SectionCard {
            title: "Release-Notes / Changelog";
            vertical-stretch: 1;

            ScrollView {
                vertical-stretch: 1;
                Text {
                    text: root.release_notes;
                    color: #d4d4d8;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        if root.status_message != "" : Text {
            text: root.status_message;
            color: root.is_error ? #f87171 : #38bdf8;
            font-size: 12px;
            wrap: word-wrap;
        }

        Text {
            text: "Möchten Sie das Update jetzt herunterladen und installieren?";
            color: #e4e4e7;
            font-size: 12px;
            font-weight: 600;
        }

        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            alignment: end;

            Button {
                text: "Später";
                enabled: !root.is_busy;
                clicked => { root.dismiss-update(); }
            }

            Button {
                text: root.is_busy ? "Installiere..." : "Jetzt aktualisieren";
                primary: true;
                enabled: !root.is_busy;
                clicked => { root.install-update(); }
            }
        }
    }
}
